# ─── Google Drive ──────────────────────────────────────────────────────────────
GOOGLE_DRIVE_FOLDER_ID=12pQVjSxHpY7AS8Zeiu375nq9rYRvwpXN

# ─── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ─── Indian Kanoon API ─────────────────────────────────────────────────────────
INDIAN_KANOON_API_TOKEN=your_token_here
INDIAN_KANOON_BASE_URL=https://api.indiankanoon.org

# ─── AnrakLegal API ────────────────────────────────────────────────────────────
ANRAK_API_KEY=your_anrak_key_here
ANRAK_BASE_URL=https://api.anraklegal.com

# ─── ChromaDB Vector Store ─────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=legal_judgments

# ─── Embedding Model ───────────────────────────────────────────────────────────
# Primary: nlpaueb/legal-bert-base-uncased  (requires ~440MB download)
# Fallback: sentence-transformers/all-MiniLM-L6-v2  (lightweight, 80MB)
EMBEDDING_MODEL=nlpaueb/legal-bert-base-uncased
USE_FALLBACK_EMBEDDING=false

# ─── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ─── Search ────────────────────────────────────────────────────────────────────
DEFAULT_TOP_K=10

# ─── Paths ─────────────────────────────────────────────────────────────────────
JUDGMENTS_DIR=./data/judgments
PARSED_DIR=./data/parsed
GRAPH_PERSIST_PATH=./data/citation_graph.gpickle

# ─── Backend ───────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
